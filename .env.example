# ---------------------------------------------------------------------------
# Interseguro - variables de entorno
# Copiar a .env antes de ejecutar:  cp .env.example .env
# Nunca subir .env al repositorio.
# ---------------------------------------------------------------------------

# --- Puertos publicados en el host -----------------------------------------
# Solo el orquestador y el front web publican puertos (ver docker-compose.yml).
ORCHESTRATOR_PORT=3000
MOBILE_WEB_PORT=8080

# --- auth-service (Node + Express) ------------------------------------------
AUTH_PORT=4000
# Vida del token en segundos (por defecto 15 min).
JWT_TTL_SECONDS=900
JWT_ISSUER=https://interseguro.local/auth
JWT_AUDIENCE=interseguro-api
# PEM de la clave privada RS256, en formato \n escapado o literal.
# Generar con: ./scripts/gen-dev-keys.sh
JWT_PRIVATE_KEY_PEM=
# Credenciales de servicio para POST /auth/validate (separadas por coma).
# Se comparan en tiempo constante.
SERVICE_API_KEYS=dev-service-key-change-me
# Usuarios semilla en formato JSON: [{"username":"demo","passwordHash":"<argon2id>"}]
# Si se deja vacio se usa DEMO_USERNAME / DEMO_PASSWORD_HASH.
AUTH_USERS=
DEMO_USERNAME=demo
# Hash argon2id de "demo-password" (valor de desarrollo, NO usar en produccion).
DEMO_PASSWORD_HASH=
# Ventana del rate limit de POST /auth/login.
LOGIN_RATE_LIMIT_WINDOW_MS=60000
LOGIN_RATE_LIMIT_MAX=20

# --- qr-api (Go + Fiber) ----------------------------------------------------
QR_PORT=8081
# Dimension maxima (filas y columnas) admitida para una matriz.
MAX_MATRIX_DIM=100
# Limite de tamano del cuerpo en bytes (413 al superarlo).
QR_MAX_BODY_BYTES=1048576

# --- stats-api (Node + Express) --------------------------------------------
STATS_PORT=4001
# Numero maximo de matrices por peticion.
MAX_MATRICES=16
# Numero total maximo de elementos entre todas las matrices.
MAX_TOTAL_ELEMENTS=20000
# Tolerancia para considerar diagonal una matriz (ver ADR-004).
DIAGONAL_EPSILON=1e-9
STATS_MAX_BODY_BYTES=1048576

# --- Autenticacion en los backends -----------------------------------------
# URL base de auth-service (red interna).
AUTH_SERVICE_URL=http://auth-service:4000
# Credencial que los backends envian en X-Service-Key al autenticar tokens.
AUTH_SERVICE_KEY=dev-service-key-change-me
# TTL de la cache de validaciones, en segundos. La latencia de revocacion
# maxima es igual a este valor (ver ADR-005).
AUTH_CACHE_TTL_SECONDS=30
# Timeout para llamar a /auth/validate, en milisegundos (fail closed -> 503).
AUTH_VALIDATE_TIMEOUT_MS=1500

# --- orchestrator (NestJS) --------------------------------------------------
NODE_ENV=production
# Orígenes permitidos por CORS. Lista separada por coma.
CORS_ORIGINS=http://localhost:8080,http://localhost:19006
QR_API_URL=http://qr-api:8081
STATS_API_URL=http://stats-api:4001
# Timeout de las llamadas a qr-api / stats-api, en milisegundos.
DOWNSTREAM_TIMEOUT_MS=3000
# Reintentos para fallos idempotentes (red / 5xx). 0 desactiva.
DOWNSTREAM_RETRIES=1
DOWNSTREAM_RETRY_BACKOFF_MS=100
# Rate limit global del orquestador.
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=120

# --- apps/mobile (front web) -----------------------------------------------
# URL del orquestador que inyecta el front en tiempo de arranque del contenedor.
API_URL=http://localhost:3000

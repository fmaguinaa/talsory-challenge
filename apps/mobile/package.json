{
  "name": "@interseguro/mobile",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build:web": "expo export --platform web --output-dir dist",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.ts\" \"src/**/*.tsx\" \"app/**/*.tsx\"",
    "lint:fix": "eslint --fix \"src/**/*.ts\" \"src/**/*.tsx\" \"app/**/*.tsx\"",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"app/**/*.tsx\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\" \"app/**/*.tsx\"",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "verify": "npm run typecheck && npm run lint && npm test"
  },
  "dependencies": {
    "expo": "~57.0.26",
    "expo-constants": "~57.0.20",
    "expo-linking": "~57.0.11",
    "expo-router": "~57.0.24",
    "expo-secure-store": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "^0.21.2",
    "react-server-dom-webpack": "19.2.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.2",
    "eslint": "^9.18.0",
    "eslint-config-expo": "~10.0.0",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.0",
    "prettier": "^3.4.2",
    "react-test-renderer": "19.2.4",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0"
  }
}
